// Based on original idea by veryfid

//@version=6
indicator(title="ZLSMA - Zero Lag LSMA (Realtime Status)", shorttitle="ZLSMA+", overlay=true, max_labels_count=200)

length = input.int(32, "Length", minval=1)
offset = input.int(0, "Offset")
src = input.source(close, "Source")

showStatusLabel = input.bool(true, "Show Realtime Status Label")
labelOffsetBars = input.int(1, "Label Offset Bars", minval=0, maxval=20)
atrLen = input.int(14, "ATR Length", minval=1)
sidewaysAtrMult = input.float(0.03, "Sideways Threshold (ATR Mult)", step=0.01, minval=0.0)
showStateBackground = input.bool(false, "Show State Background")

// Core ZLSMA calculation
lsma = ta.linreg(src, length, offset)
lsma2 = ta.linreg(lsma, length, offset)
eq = lsma - lsma2
zlsma = lsma + eq

// Realtime state classification
slope = zlsma - zlsma[1]
atrValue = ta.atr(atrLen)
sidewaysThreshold = atrValue * sidewaysAtrMult

trendState = slope > sidewaysThreshold ? 1 : slope < -sidewaysThreshold ? -1 : 0
trendText = trendState == 1 ? "UPTREND" : trendState == -1 ? "DOWNTREND" : "SIDEWAYS"
priceText = close > zlsma ? "PRICE ABOVE ZLSMA" : close < zlsma ? "PRICE BELOW ZLSMA" : "PRICE ON ZLSMA"

lineColor = trendState == 1 ? color.lime : trendState == -1 ? color.red : color.yellow
plot(zlsma, color=lineColor, linewidth=3, title="ZLSMA")

bgColor = showStateBackground ? (trendState == 1 ? color.new(color.green, 92) : trendState == -1 ? color.new(color.red, 92) : color.new(color.gray, 94)) : na
bgcolor(bgColor)

// Trend change markers (optional visual aid)
upShift = trendState == 1 and trendState[1] != 1
downShift = trendState == -1 and trendState[1] != -1
flatShift = trendState == 0 and trendState[1] != 0

plotshape(upShift, title="ZLSMA Up Shift", style=shape.triangleup, location=location.belowbar, color=color.lime, text="UP", textcolor=color.white, size=size.tiny)
plotshape(downShift, title="ZLSMA Down Shift", style=shape.triangledown, location=location.abovebar, color=color.red, text="DOWN", textcolor=color.white, size=size.tiny)
plotshape(flatShift, title="ZLSMA Sideways Shift", style=shape.circle, location=location.abovebar, color=color.yellow, text="FLAT", textcolor=color.black, size=size.tiny)

// Line-end realtime status label
var label statusLabel = na
if barstate.islast and showStatusLabel
    if not na(statusLabel)
        label.delete(statusLabel)

    functionText = "ZLSMA: Zero-Lag trend filter"
    slopeRounded = math.round(slope * 10000) / 10000
    statusText = functionText + "\nState: " + trendText + "\n" + priceText + "\nSlope: " + str.tostring(slopeRounded)
    statusColor = trendState == 1 ? color.green : trendState == -1 ? color.red : color.gray

    statusLabel := label.new(
         x=bar_index + labelOffsetBars,
         y=zlsma,
         text=statusText,
         xloc=xloc.bar_index,
         yloc=yloc.price,
         style=label.style_label_left,
         color=statusColor,
         textcolor=color.white,
         size=size.normal
     )

if (not showStatusLabel) and (not na(statusLabel))
    label.delete(statusLabel)
    statusLabel := na
